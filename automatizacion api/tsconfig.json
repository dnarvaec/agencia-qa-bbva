{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "paths": {
      "@apis/*":     ["./src/apis/*"],
      "@fixtures/*": ["./src/fixtures/*"],
      "@utils/*":    ["./src/utils/*"],
      "@schemas/*":  ["./src/schemas/*"],
      "@data/*":     ["./data/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "reports",
    "test-results"
  ]
}
